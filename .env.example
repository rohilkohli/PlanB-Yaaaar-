# PlanB server-side configuration. NEVER prefix these with VITE_ — they must not reach the client bundle.
# With nothing set, PlanB runs in zero-config mode (curated catalogue + deterministic planner).

# Google Cloud (enable: Places API (New), Geocoding API, Time Zone API). Restrict the key to those APIs.
GOOGLE_PLACES_API_KEY=

# LLM sequencing (Anthropic). PRD §24: Haiku-class model with strict JSON schema.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=5500

# Kill-switch: skip the LLM entirely (PRD §35)
USE_DETERMINISTIC_PLANNER=false

# Per-IP daily limits (PRD §18)
RATE_LIMIT_GENERATE_PER_DAY=10
RATE_LIMIT_ADAPT_PER_DAY=25

# Optional shared rate-limit store (Upstash Redis REST); falls back to in-memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
