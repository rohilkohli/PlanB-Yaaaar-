{
  "name": "planb-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.server.json",
    "test:e2e": "npm run build && tsx e2e/run.ts",
    "eval": "tsx eval/offline.ts",
    "eval:live": "tsx eval/live.ts",
    "ci": "npm run typecheck && npm test && npm run eval && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
